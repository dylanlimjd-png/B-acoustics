{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b-acoustics-digest",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // DIGEST_TO and ALERT_TO (recipient emails) are set on the Worker itself, not here,
  // because this repo is public. keep_vars stops deploys from deleting them.
  "keep_vars": true,
  // Run next to the Anthropic API: requests executed in some regions (e.g. the Hong Kong data centre) are refused
  // by the API with 403 "Request not allowed". Mailbox (Porkbun) and Resend are US-hosted too.
  "placement": { "mode": "targeted", "hostname": "api.anthropic.com" },
  // 04:00 UTC = 12:00 noon Singapore, daily.
  "triggers": { "crons": ["0 4 * * *"] },
  "kv_namespaces": [
    { "binding": "DIGEST_STATE", "id": "f252e1bcf80d4861bf4eedba0d523bb8" }
  ],
  "vars": {
    "IMAP_HOST": "imap.porkbun.com",
    "IMAP_USER": "studio@b-acoustics.com",
    "TEAM_NAMES": "Dylan, Delon, Ivan",
    "PUBLIC_URL": "https://b-acoustics-digest.dylanlimjd.workers.dev"
  }
  // Secrets (wrangler secret put): IMAP_PASSWORD, ANTHROPIC_API_KEY, RESEND_API_KEY, RUN_TOKEN
}
