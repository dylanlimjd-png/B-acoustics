{
  "name": "b-acoustics-site",
  "private": true,
  "version": "1.0.0",
  "description": "CI tooling for b-acoustics.com — the shipped site is plain static HTML with no build step.",
  "scripts": {
    "check-site": "node scripts/check-site.js",
    "validate-html": "html-validate \"index.html\" \"disclaimer.html\" \"blog/*.html\" \"services/*.html\"",
    "test:visual": "playwright test",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.48.0",
    "html-validate": "^8.24.0",
    "serve": "^14.2.3"
  }
}
